{
  "expo": {
    "name": "Özel Medya Kasası",
    "slug": "private-media-vault",
    "owner": "aliucak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.aliucak.mediavault",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_CONTACTS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Özel Medya Kasası kilidini açmak için biyometrik doğrulama kullanılır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kasaya fotoğraf ve video eklemek için medya erişimi gereklidir."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Seçilen medyaları dışa aktarmak için galeri izni gereklidir.",
          "savePhotosPermission": "Seçilen medyaları galeriye kaydetmek için izin gereklidir.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-sharing",
      "expo-video",
      [
        "expo-contacts",
        {
          "contactsPermission": "Kasaya eklenecek kişileri telefon rehberinden seçmek için izin gereklidir."
        }
      ],
      "./plugins/withWhatsAppShare"
    ],
    "extra": {
      "eas": {
        "projectId": "ba192cb5-db08-48c0-b417-f3263b34ffee"
      }
    }
  }
}
